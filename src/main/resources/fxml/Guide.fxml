<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane alignment="CENTER" prefHeight="720.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.GuideController">
    <children>
        <ImageView fitHeight="720.0" fitWidth="1024.0" pickOnBounds="true">
            <image>
                <Image url="@../image/background3.png" />
            </image>
        </ImageView>

        <VBox style="-fx-background-color: rgba(0, 0, 0, 0.7);" />

        <VBox alignment="CENTER" fillWidth="false" spacing="20.0">
            <children>
                <Label text="HƯỚNG DẪN THAM GIA ĐẤU GIÁ" textFill="WHITE">
                    <font><Font name="System Bold" size="36.0" /></font>
                </Label>

                <VBox prefWidth="850.0" spacing="15.0" style="-fx-background-color: rgba(255, 255, 255, 0.05); -fx-background-radius: 20; -fx-padding: 35; -fx-border-color: rgba(255,255,255,0.1);">
                    <children>
                        <Label lineSpacing="5.0" text="1. ĐĂNG KÝ TÀI KHOẢN: Truy cập hệ thống và hoàn tất thông tin cá nhân.&#10;&#10;2. CHỌN BIỂN SỐ: Tìm kiếm và lựa chọn biển số xe mong muốn trong danh sách niêm yết.&#10;&#10;3. NỘP TIỀN ĐẶT TRƯỚC: Thanh toán tiền hồ sơ và tiền đặt trước theo quy định để kích hoạt quyền đấu giá.&#10;&#10;4. THAM GIA ĐẤU GIÁ: Truy cập phòng đấu giá ảo đúng giờ và thực hiện trả giá.&#10;&#10;5. NHẬN KẾT QUẢ: Nếu thắng cuộc, nộp số tiền còn lại và nhận biển số tại cơ quan chức năng." textFill="WHITE" wrapText="true">
                            <font><Font size="15.0" /></font>
                        </Label>
                        <Button onAction="#handleBack" prefHeight="45.0" prefWidth="150.0" style="-fx-background-color: #0984e3; -fx-background-radius: 25; -fx-cursor: hand;" text="Quay lại" textFill="WHITE">
                            <font><Font name="System Bold" size="14.0" /></font>
                            <VBox.margin><Insets top="20.0" /></VBox.margin>
                        </Button>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>