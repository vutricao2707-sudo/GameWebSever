<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Label text="HỆ THỐNG ĐẤU GIÁ" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS" /> <TextField fx:id="txtSearch" promptText="Tìm kiếm sản phẩm..." prefWidth="200.0"/>
            <Button fx:id="btnLogout" text="Đăng xuất" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10.0" style="-fx-padding: 20;">
            <Label text="Danh sách sản phẩm đang đấu giá" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <TableView fx:id="tableProducts" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="Mã SP" prefWidth="70.0" />
                    <TableColumn fx:id="colName" text="Tên sản phẩm" prefWidth="250.0" />
                    <TableColumn fx:id="colPrice" text="Giá hiện tại ($)" prefWidth="120.0" />
                    <TableColumn fx:id="colTime" text="Thời gian còn lại" prefWidth="150.0" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 15; -fx-border-color: #bdc3c7; -fx-border-width: 1 0 0 0;">
            <Button fx:id="btnAddProduct" text="+ Thêm sản phẩm (Seller)" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;"/>
            <Button fx:id="btnViewDetail" text="Xem chi tiết / Đặt giá" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>
    </bottom>
</BorderPane>