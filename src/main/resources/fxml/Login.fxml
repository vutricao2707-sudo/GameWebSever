<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 30;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" prefHeight="400.0" prefWidth="350.0">
    <Label text="HỆ THỐNG ĐẤU GIÁ" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    <Label text="Đăng nhập để tiếp tục" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>

    <VBox spacing="5.0" style="-fx-padding: 10 0 0 0;">
        <Label text="Tên đăng nhập:"/>
        <TextField fx:id="txtUsername" promptText="Nhập username của bạn..." style="-fx-pref-height: 35px;"/>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Mật khẩu:"/>
        <PasswordField fx:id="txtPassword" promptText="Nhập mật khẩu..." style="-fx-pref-height: 35px;"/>
    </VBox>

    <VBox spacing="10.0" style="-fx-padding: 15 0 0 0;" alignment="CENTER">
        <Button fx:id="btnLogin" text="ĐĂNG NHẬP" prefWidth="200.0" style="-fx-pref-height: 40px; -fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        <Button fx:id="btnRegister" text="Chưa có tài khoản? Đăng ký ngay" style="-fx-background-color: transparent; -fx-text-fill: #2980b9; -fx-cursor: hand; -fx-underline: true;"/>
    </VBox>
</VBox>