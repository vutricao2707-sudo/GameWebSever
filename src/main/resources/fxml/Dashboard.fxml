<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.DashboardController">
    <children>
        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <ImageView fitHeight="1500.0" fitWidth="2000.0" pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@../image/background4.png" /></image>
                </ImageView>
                <VBox style="-fx-background-color: rgba(0, 0, 0, 0.85);" />
            </children>
        </StackPane>

        <HBox alignment="CENTER_LEFT" minHeight="70.0" prefHeight="70.0" spacing="20.0" style="-fx-background-color: rgba(0, 0, 0, 0.7); -fx-padding: 0 40;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="25.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Button onAction="#showHomeTab" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Trang Chủ" textFill="WHITE"><font><Font name="System Bold" size="14.0" /></font></Button>
                        <Button onAction="#showHistoryTab" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Lịch Sử Đấu Giá" textFill="WHITE"><font><Font name="System Bold" size="14.0" /></font></Button>
                        <Button onAction="#showResultsTab" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Kết Quả Đấu Giá" textFill="WHITE"><font><Font name="System Bold" size="14.0" /></font></Button>
                        <Button style="-fx-background-color: #00b894; -fx-background-radius: 20;" text="Đăng Ký Bán" textFill="WHITE"><font><Font name="System Bold" size="13.0" /></font></Button>
                    </children>
                </HBox>
                <Label text="0329625069" textFill="WHITE" />
                <MenuButton style="-fx-background-color: #00b894; -fx-background-radius: 20;" text="Tài khoản" textFill="WHITE">
                    <items>
                        <MenuItem text="Thông tin cá nhân" />
                        <MenuItem text="Đổi mật khẩu" />
                        <MenuItem onAction="#handleLogout" text="Đăng xuất" />
                    </items>
                </MenuButton>
            </children>
        </HBox>

        <TabPane fx:id="mainTabPane" style="-fx-tab-max-height: 0; -fx-tab-min-height: 0; -fx-background-color: transparent;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
            <tabs>
                <Tab closable="false">
                    <content>
                        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                            <content>
                                <VBox alignment="TOP_CENTER" spacing="30.0" style="-fx-padding: 30;">
                                    <children>
                                        <HBox alignment="CENTER" maxWidth="260.0" style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 30; -fx-padding: 2;">
                                            <children>
                                                <Button prefHeight="38.0" prefWidth="125.0" style="-fx-background-color: #00b894; -fx-background-radius: 30;" text="🚗 Ô tô" textFill="WHITE"><font><Font name="System Bold" size="13.0" /></font></Button>
                                                <Button prefHeight="38.0" prefWidth="125.0" style="-fx-background-color: transparent;" text="🏍️ Xe máy" textFill="#94a3b8"><font><Font name="System Bold" size="13.0" /></font></Button>
                                            </children>
                                        </HBox>
                                        <FlowPane alignment="CENTER" hgap="25.0" vgap="30.0">
                                            <children>
                                                <VBox prefWidth="280.0" style="-fx-background-color: #1e293b; -fx-background-radius: 15; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 15;">
                                                    <children>
                                                        <VBox alignment="CENTER" prefHeight="120.0" style="-fx-background-color: white; -fx-background-radius: 14 14 0 0;">
                                                            <children>
                                                                <Label style="-fx-text-fill: black;" text="30K"><font><Font name="System Bold" size="36.0" /></font></Label>
                                                                <Label style="-fx-text-fill: black;" text="999.99"><font><Font name="System Bold" size="42.0" /></font></Label>
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="12.0" style="-fx-padding: 20;">
                                                            <children>
                                                                <HBox><children><Label text="• Thành phố Hà Nội" textFill="#94a3b8" /><Region HBox.hgrow="ALWAYS" /><Label text="Phiên 9" textFill="#94a3b8" /></children></HBox>
                                                                <Label text="👤 150 người tham gia" textFill="#00b894" />
                                                                <Label text="Còn: 3 ngày 16 giờ 39 phút" textFill="WHITE" />
                                                                <HBox spacing="10.0">
                                                                    <Button onAction="#handleGoToAuction" maxWidth="Infinity" style="-fx-background-color: #00b894; -fx-background-radius: 20;" text="Đấu giá" textFill="WHITE" HBox.hgrow="ALWAYS" />
                                                                    <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-border-color: #00b894; -fx-border-radius: 20;" text="Chi tiết" textFill="#00b894" HBox.hgrow="ALWAYS" />
                                                                </HBox>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </FlowPane>
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>

                <Tab closable="false">
                    <content>
                        <HBox spacing="25.0" style="-fx-padding: 30;">
                            <children>
                                <VBox prefWidth="260.0" spacing="12.0" style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 25; -fx-background-radius: 15;">
                                    <children>
                                        <Label text="QUẢN LÝ TÀI KHOẢN" textFill="#00b894"><font><Font name="System Bold" size="14.0" /></font></Label>
                                        <Button maxWidth="Infinity" onAction="#showHomeTab" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT;" text="🏠 Trang chủ" textFill="WHITE" />
                                        <Button maxWidth="Infinity" style="-fx-background-color: rgba(0,184,148,0.1); -fx-text-fill: #00b894;" text="🔄 Lịch sử đấu giá" />
                                        <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT;" text="🛒 Giỏ hàng" textFill="WHITE" />
                                        <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT;" text="📄 Hồ sơ cá nhân" textFill="WHITE" />
                                    </children>
                                </VBox>
                                <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                                            <children>
                                                <TextField promptText="Tìm biển số..." prefHeight="35.0" prefWidth="250.0" />
                                                <Button text="Tìm kiếm" prefHeight="35.0" style="-fx-background-color: #00b894;" textFill="WHITE" />
                                            </children>
                                        </HBox>
                                        <TableView VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                                            <columns>
                                                <TableColumn prefWidth="120" text="Ngày" /><TableColumn prefWidth="150" text="Biển số" /><TableColumn prefWidth="180" text="Giá trả cuối" /><TableColumn prefWidth="150" text="Trạng thái" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </content>
                </Tab>

                <Tab closable="false">
                    <content>
                        <VBox alignment="TOP_CENTER" spacing="30.0" style="-fx-padding: 40;">
                            <children>
                                <Label text="KẾT QUẢ PHIÊN ĐẤU GIÁ" textFill="WHITE"><font><Font name="System Bold" size="24.0" /></font></Label>
                                <HBox alignment="CENTER" spacing="15.0">
                                    <children>
                                        <DatePicker promptText="Chọn ngày" prefHeight="40.0" />
                                        <TextField promptText="Nhập biển số..." prefHeight="40.0" prefWidth="300.0" />
                                        <Button prefHeight="40.0" style="-fx-background-color: #00b894;" text="Tra cứu" textFill="WHITE" />
                                    </children>
                                </HBox>
                                <TableView maxWidth="950.0" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn prefWidth="180" text="Ngày công bố" /><TableColumn prefWidth="250" text="Biển số" /><TableColumn prefWidth="250" text="Giá trúng" /><TableColumn prefWidth="200" text="Tỉnh/Thành" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>