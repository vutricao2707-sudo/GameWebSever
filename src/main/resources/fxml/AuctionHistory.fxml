<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.AuctionHistoryController">
    <children>
        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <ImageView fitHeight="1200.0" fitWidth="1800.0" pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@../image/background4.png" /></image>
                </ImageView>
                <VBox style="-fx-background-color: rgba(0, 0, 0, 0.85);" />
            </children>
        </StackPane>

        <HBox alignment="CENTER_LEFT" minHeight="70.0" prefHeight="70.0" spacing="20.0" style="-fx-background-color: rgba(0, 0, 0, 0.7); -fx-padding: 0 40;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Button onAction="#handleBack" style="-fx-background-color: transparent; -fx-border-color: #00b894; -fx-border-radius: 20; -fx-cursor: hand;" text="Quay lại" textFill="#00b894">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Button>
                <Region HBox.hgrow="ALWAYS" />
                <Label text="LỊCH SỬ ĐẤU GIÁ" textFill="WHITE">
                    <font><Font name="System Bold" size="22.0" /></font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Label text="0329625069" textFill="WHITE" />
            </children>
        </HBox>

        <HBox spacing="25.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
            <children>
                <VBox prefWidth="260.0" spacing="10.0" style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 15; -fx-padding: 20;">
                    <children>
                        <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="👤 Thông tin cá nhân" textFill="#bbbbbb" />
                        <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="🛒 Biển số đã đăng ký" textFill="#bbbbbb" />
                        <Button maxWidth="Infinity" style="-fx-background-color: rgba(0,184,148,0.1); -fx-alignment: CENTER_LEFT; -fx-border-color: #00b894; -fx-border-width: 0 0 0 4; -fx-cursor: hand;" text="🔄 Lịch sử đấu giá" textFill="#00b894">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                        <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="📄 Hồ sơ của tôi" textFill="#bbbbbb" />
                    </children>
                    <HBox.margin><Insets bottom="30.0" left="30.0" top="30.0" /></HBox.margin>
                </VBox>

                <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <TextField promptText="Tìm kiếm biển số..." prefHeight="35.0" prefWidth="250.0" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-background-radius: 10;" />
                                <Button style="-fx-background-color: #00b894; -fx-background-radius: 10;" text="Tìm" textFill="WHITE" prefHeight="35.0" prefWidth="80.0" />
                            </children>
                        </HBox>

                        <TableView fx:id="historyTable" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colTime" prefWidth="150" text="Thời gian" />
                                <TableColumn fx:id="colPlate" prefWidth="150" text="Biển số" />
                                <TableColumn fx:id="colPrice" prefWidth="200" text="Giá trả cuối" />
                                <TableColumn fx:id="colStatus" prefWidth="150" text="Trạng thái" />
                            </columns>
                        </TableView>
                    </children>
                    <padding><Insets bottom="30.0" right="30.0" top="30.0" /></padding>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>