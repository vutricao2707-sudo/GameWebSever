<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane alignment="CENTER" prefHeight="800.0" prefWidth="1280.0"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.controller.AuctionHistoryController">

    <ImageView fitHeight="800.0" fitWidth="1280.0" pickOnBounds="true">
        <Image url="@../image/background4.png"/>
    </ImageView>
    <Region style="-fx-background-color: rgba(0, 0, 0, 0.6);"/>

    <VBox alignment="TOP_CENTER">
        <HBox alignment="CENTER_LEFT" minHeight="65.0" prefHeight="65.0" style="-fx-background-color: rgba(0, 0, 0, 0.8); -fx-padding: 0 25;">
            <ImageView fitHeight="40.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@../image/logo3.png"/>
            </ImageView>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
                <Button onAction="#handleRegisterToSell" text="Đăng Ký Bán" textFill="WHITE" style="-fx-background-color: #00b894; -fx-background-radius: 20; -fx-cursor: hand;">
                    <font><Font name="System Bold" size="12.0"/></font>
                    <padding><Insets bottom="6.0" left="12.0" right="12.0" top="6.0"/></padding>
                </Button>
                <Label fx:id="lblUserName" text="Xin chào, User" textFill="WHITE">
                    <font><Font size="12.0"/></font>
                </Label>
                <Button onAction="#handleLogout" text="Đăng xuất" textFill="#ff6b6b" style="-fx-background-color: transparent; -fx-border-color: #ff6b6b; -fx-border-radius: 20; -fx-cursor: hand;">
                    <font><Font size="12.0"/></font>
                    <padding><Insets bottom="6.0" left="12.0" right="12.0" top="6.0"/></padding>
                </Button>
            </HBox>
        </HBox>

        <HBox alignment="CENTER" spacing="30.0" style="-fx-padding: 15 25 0 25; -fx-background-color: rgba(0,0,0,0.4);">
            <Button onAction="#handleHome" text="Trang Chủ" textFill="WHITE" style="-fx-background-color: transparent; -fx-cursor: hand;">
                <font><Font name="System Bold" size="14.0"/></font>
                <padding><Insets bottom="10.0" left="15.0" right="15.0" top="10.0"/></padding>
            </Button>

            <Button text="Lịch Sử Đấu Giá" textFill="#00b894" style="-fx-background-color: transparent; -fx-border-color: #00b894; -fx-border-width: 0 0 2 0;">
                <font><Font name="System Bold" size="14.0"/></font>
                <padding><Insets bottom="10.0" left="15.0" right="15.0" top="10.0"/></padding>
            </Button>

            <Button onAction="#handleShowResults" text="Kết Quả Đấu Giá" textFill="WHITE" style="-fx-background-color: transparent; -fx-cursor: hand;">
                <font><Font name="System Bold" size="14.0"/></font>
                <padding><Insets bottom="10.0" left="15.0" right="15.0" top="10.0"/></padding>
            </Button>
        </HBox>

        <VBox alignment="TOP_CENTER" spacing="20.0" VBox.vgrow="ALWAYS" style="-fx-padding: 30 20 50 20;">

            <Label text="LỊCH SỬ ĐẶT GIÁ" textFill="WHITE">
                <font><Font name="System Bold" size="26.0"/></font>
            </Label>

            <VBox maxWidth="900.0" style="-fx-background-color: rgba(15, 23, 42, 0.85); -fx-background-radius: 12; -fx-border-color: #334155; -fx-border-radius: 12; -fx-border-width: 1;" VBox.vgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT" style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 15 20; -fx-background-radius: 12 12 0 0; -fx-border-color: #334155; -fx-border-width: 0 0 1 0;">
                    <Label prefWidth="60.0" text="STT" textFill="#94a3b8"><font><Font name="System Bold" size="15.0"/></font></Label>
                    <Label prefWidth="180.0" text="Biển số" textFill="#94a3b8"><font><Font name="System Bold" size="15.0"/></font></Label>
                    <Label prefWidth="220.0" text="Giá đặt" textFill="#94a3b8"><font><Font name="System Bold" size="15.0"/></font></Label>
                    <Label prefWidth="200.0" text="Thời gian" textFill="#94a3b8"><font><Font name="System Bold" size="15.0"/></font></Label>
                    <Label prefWidth="180.0" text="Lần đặt thứ" textFill="#94a3b8"><font><Font name="System Bold" size="15.0"/></font></Label>
                </HBox>

                <ScrollPane fitToWidth="true" prefHeight="450.0" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                    <VBox fx:id="historyListContainer" alignment="TOP_CENTER" style="-fx-padding: 5;"/>
                </ScrollPane>

            </VBox>
        </VBox>
    </VBox>
</StackPane>