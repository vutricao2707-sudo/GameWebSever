<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1024.0"
            style="-fx-background-color: #0f172a;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.controller.AdminController">

    <left>
        <VBox prefWidth="250.0" spacing="10.0" style="-fx-background-color: #1e293b; -fx-padding: 30 20; -fx-border-color: #334155; -fx-border-width: 0 1 0 0;">

            <Label fx:id="lblAdminName" text="VPA ADMIN" textFill="WHITE">
                <font><Font name="System Bold" size="24.0"/></font>
                <VBox.margin><Insets bottom="30.0"/></VBox.margin>
            </Label>

            <Button alignment="BASELINE_LEFT" maxWidth="1000.0" text="  📋 Duyệt Xe (Chờ duyệt)" textFill="WHITE" style="-fx-background-color: rgba(56, 189, 248, 0.15); -fx-text-fill: #38bdf8; -fx-border-color: #38bdf8; -fx-border-width: 0 0 0 4; -fx-padding: 15; -fx-cursor: hand;">
                <font><Font name="System Bold" size="14.0"/></font>
            </Button>

            <Button alignment="BASELINE_LEFT" maxWidth="1000.0" text="  ⚡ Giám sát (Đang đấu)" textFill="#94a3b8" style="-fx-background-color: transparent; -fx-padding: 15; -fx-cursor: hand;">
                <font><Font name="System Bold" size="14.0"/></font>
            </Button>

            <Button alignment="BASELINE_LEFT" maxWidth="1000.0" text="  👥 Quản lý User" textFill="#94a3b8" style="-fx-background-color: transparent; -fx-padding: 15; -fx-cursor: hand;">
                <font><Font name="System Bold" size="14.0"/></font>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <Button onAction="#handleLogout" maxWidth="1000.0" text="Đăng xuất" textFill="#ef4444" style="-fx-background-color: rgba(239, 68, 68, 0.1); -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;">
                <font><Font name="System Bold" size="14.0"/></font>
            </Button>
        </VBox>
    </left>

    <center>
        <VBox spacing="25.0" style="-fx-padding: 40;">

            <HBox alignment="CENTER_LEFT">
                <VBox>
                    <Label text="DANH SÁCH CHỜ DUYỆT" textFill="WHITE">
                        <font><Font name="System Bold" size="28.0"/></font>
                    </Label>
                    <Label text="Các sản phẩm user vừa đăng, cần admin kiểm tra trước khi lên sàn." textFill="#94a3b8">
                        <font><Font size="14.0"/></font>
                    </Label>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblTotalRequests" text="Tổng cộng: 0 yêu cầu" textFill="#38bdf8">
                    <font><Font name="System Bold" size="14.0"/></font>
                </Label>
            </HBox>

            <VBox style="-fx-background-color: #1e293b; -fx-background-radius: 12; -fx-border-color: #334155; -fx-border-radius: 12;" VBox.vgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT" style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 15 20; -fx-background-radius: 12 12 0 0; -fx-border-color: #334155; -fx-border-width: 0 0 1 0;">
                    <Label prefWidth="150.0" text="Biển số" textFill="#94a3b8"><font><Font name="System Bold" size="14.0"/></font></Label>
                    <Label prefWidth="180.0" text="Người đăng" textFill="#94a3b8"><font><Font name="System Bold" size="14.0"/></font></Label>
                    <Label prefWidth="180.0" text="Giá khởi điểm" textFill="#94a3b8"><font><Font name="System Bold" size="14.0"/></font></Label>
                    <Label prefWidth="150.0" text="Thời gian kết thúc" textFill="#94a3b8"><font><Font name="System Bold" size="14.0"/></font></Label>
                    <Label prefWidth="120.0" text="Thao tác" textFill="#94a3b8" alignment="CENTER"><font><Font name="System Bold" size="14.0"/></font></Label>
                </HBox>

                <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                    <VBox fx:id="adminListContainer" spacing="0"/>
                </ScrollPane>
            </VBox>

        </VBox>
    </center>
</BorderPane>