<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1100.0"
            style="-fx-background-color: #0f172a;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.controller.AdminController">

    <!-- ══════════════════════════════════════════════════
         SIDEBAR BÊN TRÁI
    ══════════════════════════════════════════════════ -->
    <left>
        <VBox prefWidth="255.0" spacing="8.0"
              style="-fx-background-color: #1e293b; -fx-padding: 30 15; -fx-border-color: #334155; -fx-border-width: 0 1 0 0;">

            <!-- Logo / Tên admin -->
            <Label fx:id="lblAdminName" text="VPA ADMIN" textFill="WHITE">
                <font><Font name="System Bold" size="22.0"/></font>
                <VBox.margin><Insets bottom="10.0"/></VBox.margin>
            </Label>

            <Label text="QUẢN TRỊ HỆ THỐNG" textFill="#475569">
                <font><Font size="11.0"/></font>
                <VBox.margin><Insets bottom="20.0"/></VBox.margin>
            </Label>

            <!-- ── Tab 1: Duyệt xe ─────────────────────── -->
            <Button fx:id="btnPendingTab"
                    onAction="#handleShowPending"
                    alignment="BASELINE_LEFT"
                    maxWidth="1000.0"
                    text="  📋  Duyệt Xe (Chờ duyệt)"
                    style="-fx-background-color: rgba(56,189,248,0.15); -fx-text-fill: #38bdf8;
                           -fx-border-color: #38bdf8; -fx-border-width: 0 0 0 4;
                           -fx-padding: 14; -fx-cursor: hand; -fx-background-radius: 0 8 8 0;">
                <font><Font name="System Bold" size="13.0"/></font>
            </Button>

            <!-- ── Tab 2: Giám sát ─────────────────────── -->
            <Button fx:id="btnMonitorTab"
                    onAction="#handleShowMonitor"
                    alignment="BASELINE_LEFT"
                    maxWidth="1000.0"
                    text="  ⚡  Giám Sát Đấu Giá"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8;
                           -fx-padding: 14; -fx-cursor: hand;">
                <font><Font name="System Bold" size="13.0"/></font>
            </Button>

            <!-- ── Tab 3: Quản lý user ─────────────────── -->
            <Button fx:id="btnUserTab"
                    onAction="#handleShowUsers"
                    alignment="BASELINE_LEFT"
                    maxWidth="1000.0"
                    text="  👥  Quản Lý Tài Khoản"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8;
                           -fx-padding: 14; -fx-cursor: hand;">
                <font><Font name="System Bold" size="13.0"/></font>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Đăng xuất -->
            <Button onAction="#handleLogout"
                    maxWidth="1000.0"
                    text="  🚪  Đăng xuất"
                    style="-fx-background-color: rgba(239,68,68,0.1); -fx-text-fill: #ef4444;
                           -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;">
                <font><Font name="System Bold" size="13.0"/></font>
            </Button>
        </VBox>
    </left>

    <!-- ══════════════════════════════════════════════════
         NỘI DUNG CHÍNH (CENTER)
    ══════════════════════════════════════════════════ -->
    <center>
        <VBox spacing="22.0" style="-fx-padding: 35 40;">

            <!-- Tiêu đề view + bộ đếm -->
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="4.0">
                    <Label fx:id="lblViewTitle" text="DANH SÁCH CHỜ DUYỆT" textFill="WHITE">
                        <font><Font name="System Bold" size="26.0"/></font>
                    </Label>
                    <Label fx:id="lblViewSubtitle"
                           text="Các biển số vừa được đăng ký, cần xét duyệt trước khi lên sàn."
                           textFill="#64748b">
                        <font><Font size="13.0"/></font>
                    </Label>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="🧹 Ẩn biển đã kết thúc khỏi Dashboard" onAction="#handleClearFinished"
                        style="-fx-background-color: rgba(239,68,68,0.2); -fx-text-fill: #ef4444;
                               -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 8 15;">
                    <HBox.margin><Insets right="15.0"/></HBox.margin>
                </Button>

                <Label fx:id="lblTotalRequests" text="Tổng cộng: 0 yêu cầu" textFill="#38bdf8">
                    <font><Font name="System Bold" size="13.0"/></font>
                </Label>
            </HBox>

            <!-- Bảng dữ liệu -->
            <VBox style="-fx-background-color: #1e293b; -fx-background-radius: 12;
                         -fx-border-color: #334155; -fx-border-radius: 12;"
                  VBox.vgrow="ALWAYS">

                <!-- Header động — controller sẽ điền nội dung vào đây -->
                <HBox fx:id="tableHeaderRow"
                      alignment="CENTER_LEFT"
                      style="-fx-background-color: rgba(255,255,255,0.05);
                             -fx-padding: 14 20;
                             -fx-background-radius: 12 12 0 0;
                             -fx-border-color: #334155; -fx-border-width: 0 0 1 0;"/>

                <!-- Nội dung cuộn -->
                <ScrollPane fitToWidth="true"
                            style="-fx-background: transparent; -fx-background-color: transparent;"
                            VBox.vgrow="ALWAYS">
                    <VBox fx:id="adminListContainer" spacing="0"/>
                </ScrollPane>
            </VBox>

        </VBox>
    </center>

</BorderPane>
