<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane alignment="CENTER" prefHeight="800.0" prefWidth="1280.0"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.controller.DashboardController">

    <ImageView fitHeight="800.0" fitWidth="1280.0"
               pickOnBounds="true">
        <Image url="@../image/background4.png"/>
    </ImageView>

    <Region style="-fx-background-color: rgba(0, 0, 0, 0.6);"/>

    <VBox alignment="TOP_CENTER">

        <HBox alignment="CENTER_LEFT" minHeight="65.0" prefHeight="65.0"
              style="-fx-background-color: rgba(0, 0, 0, 0.8); -fx-padding: 0 25;">
            <ImageView fitHeight="40.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@../image/logo3.png"/>
            </ImageView>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER_RIGHT" spacing="15.0">
                <Button onAction="#handleRegisterToSell" text="Đăng Ký Bán"
                        textFill="WHITE"
                        style="-fx-background-color: #00b894; -fx-background-radius: 20; -fx-cursor: hand;">
                    <font>
                        <Font name="System Bold" size="12.0"/>
                    </font>
                    <padding>
                        <Insets bottom="6.0" left="12.0" right="12.0" top="6.0"/>
                    </padding>
                </Button>

                <Label fx:id="lblUserName" text="Xin chào, User" textFill="WHITE">
                    <font><Font size="12.0"/></font>
                </Label>


                <Button onAction="#handleLogout" text="Đăng xuất"
                        textFill="#ff6b6b"
                        style="-fx-background-color: transparent; -fx-border-color: #ff6b6b; -fx-border-radius: 20; -fx-cursor: hand;">
                    <font>
                        <Font size="12.0"/>
                    </font>
                    <padding>
                        <Insets bottom="6.0" left="12.0" right="12.0" top="6.0"/>
                    </padding>
                </Button>
            </HBox>
        </HBox>

        <HBox alignment="CENTER" spacing="30.0"
              style="-fx-padding: 15 25 0 25; -fx-background-color: rgba(0,0,0,0.4);">
            <Button fx:id="btnHome" onAction="#handleHome"
                    text="Trang Chủ" textFill="#00b894"
                    style="-fx-background-color: transparent; -fx-border-color: #00b894; -fx-border-width: 0 0 2 0;">
                <font>
                    <Font name="System Bold" size="14.0"/>
                </font>
                <padding>
                    <Insets bottom="10.0" left="15.0" right="15.0" top="10.0"/>
                </padding>
            </Button>

            <Button fx:id="btnHistory" onAction="#handleShowHistory"
                    text="Lịch Sử Đấu Giá" textFill="WHITE"
                    style="-fx-background-color: transparent;">
                <font>
                    <Font name="System Bold" size="14.0"/>
                </font>
                <padding>
                    <Insets bottom="10.0" left="15.0" right="15.0" top="10.0"/>
                </padding>
            </Button>

            <Button fx:id="btnResults" onAction="#handleShowResults"
                    text="Kết Quả Đấu Giá" textFill="WHITE"
                    style="-fx-background-color: transparent;">
                <font>
                    <Font name="System Bold" size="14.0"/>
                </font>
                <padding>
                    <Insets bottom="10.0" left="15.0" right="15.0" top="10.0"/>
                </padding>
            </Button>
        </HBox>

        <VBox spacing="20.0" style="-fx-padding: 25;" VBox.vgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT">
                <HBox alignment="CENTER"
                      style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 35; -fx-padding: 4;">
                    <Button fx:id="btnCar" onAction="#handleToggleCar"
                            prefHeight="36.0" prefWidth="110.0"
                            text="🚗 Ô tô" textFill="WHITE"
                            style="-fx-background-color: #00b894; -fx-background-radius: 32; -fx-cursor: hand;">
                        <font>
                            <Font name="System Bold" size="13.0"/>
                        </font>
                    </Button>
                    <Button fx:id="btnBike" onAction="#handleToggleBike"
                            prefHeight="36.0" prefWidth="110.0"
                            text="🏍Xe máy" textFill="#cccccc"
                            style="-fx-background-color: transparent; -fx-background-radius: 32; -fx-cursor: hand;">
                        <font>
                            <Font name="System Bold" size="13.0"/>
                        </font>
                    </Button>
                </HBox>
            </HBox>

            <ScrollPane fitToWidth="true"
                        style="-fx-background: transparent; -fx-background-color: transparent;"
                        VBox.vgrow="ALWAYS">
                <FlowPane fx:id="productContainer"
                          alignment="CENTER"
                          hgap="20.0" vgap="20.0"
                          style="-fx-padding: 10;">
                </FlowPane>
            </ScrollPane>

        </VBox>

    </VBox>

</StackPane>